---
const { title, subtitle, anchorId } = Astro.props;

---
<section id={anchorId} class="py-24 px-6 bg-white dark:bg-gray-800">
  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-slate-900 dark:text-white">{title}</h2>
        <p class="text-slate-600 text-lg dark:text-slate-300">{subtitle}</p>
    </div>
    <slot />
  </div>
</section>
