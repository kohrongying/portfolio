---
---

<section id="hero" class="min-h-screen flex items-center justify-center pt-20 px-6 dark:bg-gray-800">
  <div class="container mx-auto max-w-6xl">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <div class="space-y-2">
          <p class="text-primary font-semibold text-lg">Hey there! 👋</p>
          <h1 class="text-5xl md:text-6xl font-bold text-slate-900 dark:text-white">
            I'm <span class="gradient-text">Rong Ying</span>
          </h1>
        </div>

        <p class="text-xl text-slate-600 leading-relaxed dark:text-slate-300">
          Software Developer passionate about building modern products.
          I love turning ideas into reality through clean code and thoughtful design.
        </p>

        <div class="flex items-center gap-4 pt-4">
          <a
            href="#contact"
            class="px-8 py-3 bg-gradient-to-r from-primary to-secondary text-white rounded-lg font-semibold hover:shadow-lg transition-all duration-300 hover:scale-105"
          >
            Get in Touch
          </a>
          <a
            href="https://blog.rongying.co"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3 border-2 border-primary text-primary rounded-lg font-semibold hover:bg-primary hover:text-white transition-all duration-300"
          >
            Read My Blog
          </a>
        </div>

        <div class="flex items-center gap-6 pt-6">
          <div class="text-center">
            <div class="text-3xl font-bold gradient-text dark:text-white">88+</div>
            <div class="text-sm text-slate-600">Repositories</div>
          </div>
          <div class="w-px h-12 bg-slate-300"></div>
          <div class="text-center">
            <div class="text-3xl font-bold gradient-text dark:text-white">27</div>
            <div class="text-sm text-slate-600">Followers</div>
          </div>
          <div class="w-px h-12 bg-slate-300"></div>
          <div class="text-center">
            <div class="text-3xl font-bold gradient-text dark:text-white">∞</div>
            <div class="text-sm text-slate-600">Ideas</div>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="relative z-10">
          <img
            src="https://avatars.githubusercontent.com/u/15882046?v=4"
            alt="Rong Ying"
            class="rounded-2xl shadow-2xl w-full max-w-md mx-auto"
          />
        </div>
        <div class="absolute -inset-4 bg-gradient-to-r from-primary to-secondary rounded-2xl blur-2xl opacity-20 -z-10"></div>
      </div>
    </div>
  </div>
</section>
