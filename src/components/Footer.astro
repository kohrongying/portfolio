---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-white py-12 px-6">
  <div class="container mx-auto max-w-6xl">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="text-2xl font-bold gradient-text mb-4">RY</h3>
        <p class="text-slate-400">
          Just a software person
        </p>
      </div>

      <div>
        <h4 class="font-bold mb-4">Quick Links</h4>
        <div class="space-y-2">
          <a href="#about" class="block text-slate-400 hover:text-white transition-colors">About</a>
          <a href="#projects" class="block text-slate-400 hover:text-white transition-colors">Projects</a>
          <a href="#skills" class="block text-slate-400 hover:text-white transition-colors">Skills</a>
          <a href="#contact" class="block text-slate-400 hover:text-white transition-colors">Contact</a>
        </div>
      </div>

      <div>
        <h4 class="font-bold mb-4">Connect</h4>
        <div class="flex gap-4">
          <a
            href="https://github.com/kohrongying"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/rongyingkoh/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors"
          >
            LinkedIn
          </a>
          <a
            href="https://blog.rongying.co"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors"
          >
            Blog
          </a>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8 text-center text-slate-400">
      <p>&copy; {currentYear} Rong Ying. Built with Astro & Tailwind CSS (& AI of course).</p>
    </div>
  </div>
</footer>
